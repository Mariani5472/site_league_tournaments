DATABASE_URL=postgresql://admin:admin@postgres:5432/lol_tournament
# PostgreSQL pool defaults for local development.
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_MS=15000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info
# Maximum time for graceful HTTP, Socket.IO, worker and database shutdown.
SHUTDOWN_TIMEOUT_MS=25000
HTTP_RATE_LIMIT=120
HTTP_USER_RATE_LIMIT=60
HTTP_RATE_LIMIT_WINDOW_MS=60000
PLAYER_SEARCH_RATE_LIMIT=20
PLAYER_SEARCH_RATE_LIMIT_WINDOW_MS=60000
SOCKET_CONNECTION_RATE_LIMIT=20
SOCKET_EVENT_RATE_LIMIT=30
SOCKET_RATE_LIMIT_WINDOW_MS=60000
SOCKET_EVENT_PAYLOAD_MAX_BYTES=1024
TRUST_PROXY_HOPS=0
INSTANCE_COUNT=1
REALTIME_REVOCATION_MODE=local
# Optional outside production. If set, scrape with Authorization: Bearer <token>.
# METRICS_TOKEN=

# Optional: only needed to enable Riot account linking.
# RIOT_DEVELOPMENT_API_KEY=
# RIOT_REGION=americas
