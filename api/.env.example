DATABASE_URL=postgresql://admin:admin@postgres:5432/lol_tournament
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info
# Maximum time for graceful HTTP, Socket.IO, worker and database shutdown.
SHUTDOWN_TIMEOUT_MS=25000
HTTP_RATE_LIMIT=120
HTTP_USER_RATE_LIMIT=60
HTTP_RATE_LIMIT_WINDOW_MS=60000
SOCKET_CONNECTION_RATE_LIMIT=20
SOCKET_EVENT_RATE_LIMIT=30
SOCKET_RATE_LIMIT_WINDOW_MS=60000
TRUST_PROXY_HOPS=0
INSTANCE_COUNT=1
REALTIME_REVOCATION_MODE=local

# Optional: only needed to enable Riot account linking.
# RIOT_DEVELOPMENT_API_KEY=
# RIOT_REGION=americas
