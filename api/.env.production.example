NODE_ENV=production
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Conservative defaults for free/small Supabase and Render tiers.
DB_POOL_MAX=5
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=10000
DB_STATEMENT_TIMEOUT_MS=10000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
CORS_ORIGINS=https://app.example.com
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=25000
HTTP_RATE_LIMIT=120
HTTP_USER_RATE_LIMIT=60
HTTP_RATE_LIMIT_WINDOW_MS=60000
PLAYER_SEARCH_RATE_LIMIT=20
PLAYER_SEARCH_RATE_LIMIT_WINDOW_MS=60000
OPS_SEARCH_RATE_LIMIT=30
OPS_SEARCH_RATE_LIMIT_WINDOW_MS=60000
SOCKET_CONNECTION_RATE_LIMIT=20
SOCKET_EVENT_RATE_LIMIT=30
SOCKET_RATE_LIMIT_WINDOW_MS=60000
SOCKET_EVENT_PAYLOAD_MAX_BYTES=1024
TRUST_PROXY_HOPS=1
INSTANCE_COUNT=1
REALTIME_REVOCATION_MODE=local
METRICS_TOKEN=generate-a-long-random-secret

# Optional Riot profile linking only
# RIOT_DEVELOPMENT_API_KEY=
# RIOT_REGION=americas
