{
  "name": "fpl-lol-api",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon --legacy-watch --watch src --ext ts --exec tsx src/server.ts",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "build": "tsc --skipLibCheck",
    "start": "node dist/server.js",
    "test:integration": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "seed:dev": "tsx src/database/seed-development.ts",
    "migrate:create": "npx node-pg-migrate create",
    "migrate:up": "npx node-pg-migrate up",
    "migrate:down": "npx node-pg-migrate down",
    "migrate:down:all": "npx node-pg-migrate down -1",
    "migrate:adopt": "node scripts/adopt-migration-history.mjs",
    "schema:compare": "node scripts/compare-database-schemas.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.0",
    "axios": "^1.16.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "pg": "^8.21.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.5",
    "@types/pg": "^8.20.0",
    "node-pg-migrate": "^8.0.4",
    "nodemon": "^3.1.14",
    "supabase": "^2.115.0",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  }
}
